# Application
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_FRONTEND_ORIGIN=http://localhost:3000

# SQLite boundary (schema creation is intentionally not scaffolded)
APP_DATABASE_PATH=inventory.db

# Celery
APP_CELERY_BROKER_URL=redis://localhost:6379/0
APP_CELERY_RESULT_BACKEND=redis://localhost:6379/1
APP_CELERY_RESULT_EXPIRES_SECONDS=3600

# LLM boundary (no live provider is implemented yet)
APP_LLM_PROVIDER=unconfigured
APP_LLM_MODEL=unconfigured
APP_LLM_API_KEY=

