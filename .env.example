# Application
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_FRONTEND_ORIGIN=http://localhost:3000

# SQLite application data and transient staged sources
APP_DATABASE_PATH=inventory.db
APP_UPLOAD_DIR=.local/invoices
APP_MAX_UPLOAD_BYTES=10485760
APP_DEFAULT_CURRENCY=USD
APP_WORKFLOW_TIMEOUT_SECONDS=300

# Celery
APP_CELERY_BROKER_URL=redis://localhost:6379/0
APP_CELERY_RESULT_BACKEND=redis://localhost:6379/1
APP_CELERY_RESULT_EXPIRES_SECONDS=3600

# Provider boundary. Offline requires no key or network.
APP_LLM_PROVIDER=offline
APP_LLM_MODEL=deterministic-v1
APP_GROK_MODEL=grok-4.5
# XAI_API_KEY=replace_only_for_live_grok
